# Copy to local.conf and adjust as needed:
#   cp build/conf/local.conf.template build/conf/local.conf

MACHINE ?= "raspberrypi4-64"
DISTRO  ?= "poky"

DISTRO_FEATURES:append = " systemd"
VIRTUAL-RUNTIME_init_manager = "systemd"
DISTRO_FEATURES_BACKFILL_CONSIDERED:append = " sysvinit"
VIRTUAL-RUNTIME_initscripts = "systemd-compat-units"

# Lighter package format than RPM
PACKAGE_CLASSES ?= "package_ipk"

# WARNING: debug-tweaks enables root login without a password.
# Remove this line before any production or security-sensitive deployment.
EXTRA_IMAGE_FEATURES ?= "debug-tweaks"

DL_DIR    ?= "${TOPDIR}/../downloads"
SSTATE_DIR ?= "${TOPDIR}/../sstate-cache"

BB_NUMBER_THREADS ?= "4"
PARALLEL_MAKE     ?= "-j4"

BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
"

CONF_VERSION = "2"
